# Database
DATABASE_URL=postgresql://daddymoto_user:password@localhost:5432/daddymoto_prod

# NextAuth
NEXTAUTH_SECRET=your-secret-here-run-openssl-rand-base64-32
NEXTAUTH_URL=https://daddymoto.com

# Cloudflare R2 (for listing photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=daddymoto-listings
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Email (transactional — Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@daddymoto.com

# Site
NEXT_PUBLIC_SITE_URL=https://daddymoto.com
NEXT_PUBLIC_SITE_NAME=Daddy Moto
